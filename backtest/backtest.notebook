---
version: 4
---
```typescript
import { backtest, analyze, computeEquityCurve, computeDrawdown } from "grademark";
import { mySharpePort } from "@csikosbalint/fire-app/ports";
import { historicalDataPort } from '@csikosbalint/fire-app/ports/server'
import * as dataForge from 'data-forge'

async function main() {
    const { subscribe, augment } = mySharpePort();
    const { retrieve } = historicalDataPort()
    const startDate = new Date()
    startDate.setFullYear(startDate.getFullYear() - 2) // 2 years ago
    const endDate = new Date()

    const data = await retrieve({ ticker: 'PPFB.DE', startDate, endDate })
    const dataWithSharpe = await augment({data, lookback: 125})
    const df = new dataForge.DataFrame(dataWithSharpe)
        // .parseDates('data', "D/MM/YYYY")
        // .parseFloats(['open', 'high', 'low', 'close', 'volume'])
        // .setIndex('date')
        // .renameSeries({ data: 'time' })
        // .bake()
    display(df.head(5).toArray(), 'table')
    display({
        chart: { type: 'line' },
        series: [{
            name: 'close',
            data: df.toArray().map((row: any) => ({ x: row.date, y: row.close }))
        }]
    }, 'apex')
}
console.log("Starting...");
main()
    .then(() => console.log("Finished"))
    .catch((err) => {
        console.error("An error occurred.");
        console.error((err && err.stack) || err);
    });
```


